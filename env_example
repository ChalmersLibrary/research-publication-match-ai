ES_URL=http://localhost:9200
ES_UID=elastic_user
ES_PW=elastic_password
ES_INDEX=publications-test
OUTFILE_CSV=results
QUERY=maritime marine shipping seafood aquaculture blue bioeconomy ocean currents wrecks ships boats
START_YEAR=2016
POOL_SIZE=100
MAX_RESULTS=1000
SEARCH_MODE=hybrid   # hybrid (default) | semantic | keyword
STATIC_QUERY=Categories.NameEng:"Materials Science"   # optional fixed ES query_string fused in as a third pool (hybrid mode only), to guarantee recall for a known category/filter regardless of QUERY relevance. Leave unset to disable.
STATIC_WEIGHT=1.0
CSV_FIELDS=Id,Title,IdentifierDoi[0],IdentifierScopusId[0],Persons[*].PersonData.DisplayName,Persons[*].PersonData.IdentifierCid[0],Abstract,Year,PublicationType.NameEng,Categories[Type.Id=fba59577-7c91-4a65-9154-7fd8b630f81a].NameEng   # optional, comma-separated field paths fetched and written as CSV columns, in order. Must have the same number of entries as CSV_HEADER. Omit both to use this default.
CSV_HEADER=Id,Title,DOI,Scopus ID,Authors,CID,Abstract,Year,PublicationType,Chalmers AoA   # optional, comma-separated display labels for the CSV_FIELDS columns above, in the same order. Omit both to use this default.
PUBTYPE_FILTER=Journal article,Paper in proceeding,Book,Book chapter,Other text in scientific journal,Review article # leave unset to include all   
